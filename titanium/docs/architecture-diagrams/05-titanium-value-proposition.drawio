        <mxCell id="title" parent="1" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#232F3E;" value="Where Does Titanium Fit? — 3 Phases of a Well-Architected Landing Zone" vertex="1">
          <mxGeometry height="50" width="875" x="355" y="5" as="geometry" />
        </mxCell>
        <mxCell id="phase1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;dashed=0;container=0;verticalAlign=top;fontStyle=1;fontSize=16;fontColor=#2E7D32;" value="Phase 1 — AWS Control Tower Baseline" vertex="1">
