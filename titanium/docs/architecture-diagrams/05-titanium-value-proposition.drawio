        <mxCell id="phase2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;dashed=0;container=0;verticalAlign=top;fontStyle=1;fontSize=16;fontColor=#1565C0;" value="Phase 2 — Titanium Automation Layer" vertex="1">
          <mxGeometry height="540" width="1400" x="30" y="400" as="geometry" />
        </mxCell>
        <mxCell id="phase3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;dashed=0;container=0;verticalAlign=top;fontStyle=1;fontSize=16;fontColor=#E65100;" value="Phase 3 — Customer Responsibility (Beyond Automation)" vertex="1">
