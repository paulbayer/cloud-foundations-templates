        </mxCell>
        <mxCell id="value-callout" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;dashed=0;container=1;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#FFFFFF;" value="Do I Need Titanium?" vertex="1">
          <mxGeometry height="170" width="1410" x="30" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="vc-text" parent="value-callout" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#FFFFFF;whiteSpace=wrap;" value="&lt;b&gt;Without Titanium:&lt;/b&gt; Control Tower gives you a basic multi-account structure. You then spend &lt;b&gt;weeks to months&lt;/b&gt; manually building CloudFormation templates for networking, security services, identity, logging, and cost management — each requiring deep AWS expertise.&lt;br&gt;&lt;br&gt;&lt;b&gt;With Titanium:&lt;/b&gt; Answer an industry-tailored interview → generate a single Titanium.yaml → produce 30+ production-ready CloudFormation templates → deploy a Well-Architected landing zone in &lt;b&gt;hours, not months&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Bottom line:&lt;/b&gt; If you need anything beyond Phase 1 (and you do), Titanium eliminates the entire Phase 2 engineering effort." vertex="1">
          <mxGeometry height="130" width="1370" x="20" y="30" as="geometry" />
        </mxCell>
        <mxCell id="arrow-p1-p2" edge="1" parent="1" source="phase1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;strokeWidth=3;fontSize=12;fontColor=#1565C0;fontStyle=1;verticalAlign=bottom;" target="phase2" value="Titanium adds →">
